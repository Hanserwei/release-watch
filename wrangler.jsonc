{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "release-watch",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/telegram/webhook"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "release-watch",
      "database_id": "855eb7ff-c958-46f8-8a96-679fe296e7da",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "POLL_BATCH_SIZE": "3",
    "DELIVERY_BATCH_SIZE": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
