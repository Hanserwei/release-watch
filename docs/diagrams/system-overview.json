  "cards": [
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "管理接口验证 Bearer ADMIN_TOKEN；匿名接口只返回公开字段白名单。",
        "Webhook 校验独立 secret、用户白名单与私聊来源。",
        "DeepSeek Key 可在后台或环境配置；响应与日志不回显密钥。"
      ]
    },
    {
      "dot": "cyan",
      "title": "版本发现",
      "items": [
        "首次成功读取最新页建立基线，订阅前的历史版本不补发。",
        "每页 15 条；最新页使用 ETag，历史分页持续后台扫描。",
        "暂停、预发布策略和订阅时间共同决定通知资格。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可恢复投递",
      "items": [
        "D1 outbox 与会话锁使用 60 秒租约；失败至多尝试 8 次。",
        "先发封面与 1024 字说明；后续文字每段最多 4000 字。",
        "保存图片消息号和文本 offset，后续调度从已记录位置继续。"
      ]
    },
    {
      "dot": "violet",
      "title": "可选中文摘要",
      "items": [
        "完整 changelog 交给 deepseek-chat；body 或 tag 变化使摘要缓存失效。",
        "未配置、停用、超时或异常时发送原文，长原文分段保留。",
        "不可用的图片回退文字；Telegram 429 按 Retry-After 重试。"
      ]
    }
  ]
