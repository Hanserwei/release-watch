{
  "name": "release-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "predev:api": "npm run build",
    "dev:api": "wrangler dev --port 8787 --test-scheduled",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "secrets:upload": "node scripts/upload-secrets.mjs",
    "telegram:webhook": "node scripts/telegram-webhook.mjs"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
